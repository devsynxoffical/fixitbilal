# SPA fallback for LiteSpeed / Apache (cPanel)
# Serves index.html for client-side routes so refresh does not 404.

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # Existing files and directories are served as-is
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # Everything else → React app
  RewriteRule ^ index.html [L]
</IfModule>

# Soft fallback if rewrite is disabled on the host
ErrorDocument 404 /index.html
